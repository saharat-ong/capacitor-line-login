{
  "name": "@saharat-ong/capacitor-line-login",
  "version": "0.1.0",
  "description": "Capacitor 8 plugin for app-to-app LINE Login (LINE SDK for iOS / Android).",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "SaharatOngCapacitorLineLogin.podspec",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "author": "saharat-ong",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/saharat-ong/capacitor-line-login.git"
  },
  "bugs": {
    "url": "https://github.com/saharat-ong/capacitor-line-login/issues"
  },
  "homepage": "https://github.com/saharat-ong/capacitor-line-login#readme",
  "keywords": [
    "capacitor",
    "plugin",
    "line",
    "line-login",
    "oauth",
    "openid"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "watch": "tsc --watch",
    "check": "node scripts/selfcheck.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.0.0",
    "rimraf": "^6.0.0",
    "rollup": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
